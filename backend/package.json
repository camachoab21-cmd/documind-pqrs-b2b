{
  "name": "documind-backend",
  "version": "1.0.0",
  "description": "DocuMind V1.0 - Backend API REST con IA (Node.js + Express + MySQL + Pinecone)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch-path=app.js --watch-path=server.js --watch-path=controllers --watch-path=routes --watch-path=services --watch-path=middleware --watch-path=config server.js",
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testEnvironment node --forceExit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@pinecone-database/pinecone": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^2.3.0",
    "mysql2": "^3.10.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.6": true
  }
}
